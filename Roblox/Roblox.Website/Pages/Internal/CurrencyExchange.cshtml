@page "/internal/exchange"
@model Roblox.Website.Pages.Internal.CurrencyExchange

@{
    Layout = "Shared/_Layout";
}

@section MetaTags {
    <title>Exchange Currency</title>
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-lg-6 offset-lg-3">
            <div class="card card-body bg-dark text-light">
                <h2>Exchange Currency</h2>
                @if (Model.userSession != null)
                {
                    <p>You currently have <strong>@Model.robuxBalance</strong> Robux and <strong>@Model.tixBalance</strong> Tix.</p>
                }
                @if (Model.successMessage != null)
                {
                    <p class="text-success">@Model.successMessage</p>
                }
                @if (Model.errorMessage != null)
                {
                    <p class="text-danger">@Model.errorMessage</p>
                }
                <form method="post" autocomplete="off">
                    <div class="mt-4">
                        <label for="currencyToSell">Currency to Sell</label>
                        <select class="form-control" id="currencyToSell" name="currencyToSell">
                            <option value="Robux" @(Model.currencyToSell == "Tix" ? "" : "selected")>Robux</option>
                            <option value="Tix" @(Model.currencyToSell == "Tix" ? "selected" : "")>Tix</option>
                        </select>
                    </div>
                    <div class="mt-4">
                        <label for="amount">Amount</label>
                        <input type="number" class="form-control" id="amount" name="amount" value="@Model.amount" placeholder="0" />
                    </div>
                    @Html.AntiForgeryToken()
                    <input type="submit" class="btn btn-primary mt-4" value="Exchange" />
                </form>
            </div>
        </div>
    </div>
</div>
