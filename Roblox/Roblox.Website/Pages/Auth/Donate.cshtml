@page "/auth/donate"
@model Roblox.Website.Pages.Auth.Donate

@{
    Layout = "Shared/_Layout";
}

@section MetaTags {
    <title>Support Pekora - Donate</title>
}

<!-- Cryptocoins CSS & JS -->
<script src="https://cdn.jsdelivr.net/npm/cryptocoins-icons@2.9.0/gulpfile.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/cryptocoins-icons@2.9.0/webfont/cryptocoins.min.css" rel="stylesheet">

<div class="container">
    <div class="row">
        <div class="col-12 col-lg-6 offset-lg-3">
            <h2 class="mt-4 mb-4">Support Pekora - Donate</h2>
            <p class="fw-bolder mt-4 mb-2">Cryptocurrency Wallets</p>
            <ul class="list-unstyled">
                <li class="d-flex align-items-center mb-2">
                    <i class="cc BTC fs-4 me-2" title="Bitcoin"></i>
                    <strong>Bitcoin (BTC):</strong> 
                    <code class="ms-1">bc1qa9j2dtqa7ux3c9p5wl9g02rz6lkaj99qkznkm7</code>
                </li>
                <li class="d-flex align-items-center mb-2">
                    <i class="cc ETH fs-4 me-2" title="Ethereum / USDT / USDC"></i>
                    <strong>Ethereum / USDT / USDC:</strong> 
                    <code class="ms-1">0x9514c6Be4998eA634Ae1cf604d209522d2D23055</code>
                </li>
                <li class="d-flex align-items-center mb-2">
                    <i class="cc LTC fs-4 me-2" title="Litecoin"></i>
                    <strong>Litecoin (LTC):</strong> 
                    <code class="ms-1">LfUXnFN6goYUoWVtshxhvgCZBWJsH7dah9</code>
                </li>
                <li class="d-flex align-items-center mb-2">
                    <i class="cc SOL fs-4 me-2" title="Solana"></i>
                    <strong>Solana (SOL):</strong> 
                    <code class="ms-1">GKk25ECU5UEbV54VmXpKKeuWhwoiAZiT8jKCBqfggLum</code>
                </li>
                <li class="d-flex align-items-center mb-2">
                    <i class="cc XMR fs-4 me-2" title="Monero"></i>
                    <strong>Monero (XMR):</strong> 
                    <code class="ms-1">47cmgoRY3zDguToMZFRZfQdgJ6hPWSsaz1VUp1Jr1cLhFGZatLhyDTCWqXunnYNCazNz4zvzsNXP6KHCHnhZSitJ73WzxpP</code>
                </li>
            </ul>

            <p class="fw-bolder mt-4 mb-2">Other Methods</p>
            <ul class="list-unstyled">
                <li class="d-flex align-items-center mb-2">
                    <i class="bi-paypal fs-4 text-primary me-2" aria-hidden="true"></i>
                    <strong>PayPal:</strong> 
                    <a href="https://ko-fi.com/gatoasti?g=0" target="_blank" class="ms-1">https://ko-fi.com/gatoasti?g=0</a>
                </li>
                <li class="d-flex align-items-center mb-2">
                    <i class="bi-coin fs-4 text-success me-2" aria-hidden="true"></i>
                    <strong>Cash App:</strong> 
                    <code class="ms-1">$boxed404</code>
                </li>
            </ul>

            <p class="mt-4">
                <strong>Where your donations go:</strong><br />
                At the end of the month we will show how every dollar donated goes back into pekora with invoice proof. 
                All donated money does not go to us and we make <span class="text-decoration-underline">zero profit</span> from Pekora.
            </p>
        </div>
    </div>
</div>
