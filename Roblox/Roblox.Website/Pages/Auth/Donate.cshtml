@page "/auth/donate"
@model Roblox.Website.Pages.Auth.Donate

@{
    Layout = "Shared/_Layout";
}

@section MetaTags {
    <title>Support Pekora - Donate</title>
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            <h2 class="mt-4 mb-4 text-center">Support Pekora - Donate</h2>

            <p class="fw-bold mt-4 mb-3">Cryptocurrency Wallets</p>
            <ul class="list-unstyled">
                <li class="d-flex align-items-center mb-3">
                    <i class="cc BTC fs-4 me-3" title="Bitcoin"></i>
                    <strong class="me-2">Bitcoin (BTC):</strong>
                    <code class="text-break">bc1qa9j2dtqa7ux3c9p5wl9g02rz6lkaj99qkznkm7</code>
                </li>
                <li class="d-flex align-items-center mb-3">
                    <i class="cc ETH fs-4 me-3" title="Ethereum / USDT / USDC"></i>
                    <strong class="me-2">Ethereum / USDT / USDC:</strong>
                    <code class="text-break">0x9514c6Be4998eA634Ae1cf604d209522d2D23055</code>
                </li>
                <li class="d-flex align-items-center mb-3">
                    <i class="cc LTC fs-4 me-3" title="Litecoin"></i>
                    <strong class="me-2">Litecoin (LTC):</strong>
                    <code class="text-break">LfUXnFN6goYUoWVtshxhvgCZBWJsH7dah9</code>
                </li>
                <li class="d-flex align-items-center mb-3">
                    <i class="cc SOL fs-4 me-3" title="Solana"></i>
                    <strong class="me-2">Solana (SOL):</strong>
                    <code class="text-break">GKk25ECU5UEbV54VmXpKKeuWhwoiAZiT8jKCBqfggLum</code>
                </li>
                <li class="d-flex align-items-center mb-3">
                    <i class="cc XMR fs-4 me-3" title="Monero"></i>
                    <strong class="me-2">Monero (XMR):</strong>
                    <code class="text-break">
                        47cmgoRY3zDguToMZFRZfQdgJ6hPWSsaz1VUp1Jr1cLhFGZatLhyDTCWqXunnYNCazNz4zvzsNXP6KHCHnhZSitJ73WzxpP
                    </code>
                </li>
            </ul>

            <p class="fw-bold mt-5 mb-3">Other Methods</p>
            <ul class="list-unstyled">
                <li class="d-flex align-items-center mb-3">
                    <i class="bi-paypal fs-4 text-primary me-3" aria-hidden="true"></i>
                    <strong class="me-2">PayPal:</strong>
                    <a href="https://ko-fi.com/gatoasti?g=0" target="_blank" class="text-break">https://ko-fi.com/gatoasti?g=0</a>
                </li>
                <li class="d-flex align-items-center mb-3">
                    <i class="bi-coin fs-4 text-success me-3" aria-hidden="true"></i>
                    <strong class="me-2">Cash App:</strong>
                    <code>$boxed404</code>
                </li>
            </ul>

            <p class="mt-5">
                <strong>Where your donations go:</strong><br />
                At the end of the month, we will show how every dollar donated goes back into Pekora with invoice proof. 
                All donated money does not go to us and we make <span class="text-decoration-underline">zero profit</span> from Pekora.
            </p>
        </div>
    </div>
</div>
